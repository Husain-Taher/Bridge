# ==============================================================================
# BRIDGE: Cross-Device Personal Transfer Service
# Environment Configuration
# ==============================================================================

# Supabase Project Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Server-side ONLY; never expose to client)
# Used only if running administrative maintenance scripts or automated tests
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Public App URL (used for QR code pairing links and OAuth redirects)
# Local: http://localhost:3000
# Production: https://your-bridge-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Default retention period for transfer items (in hours)
NEXT_PUBLIC_DEFAULT_RETENTION_HOURS=72

# Storage bucket name for encrypted files (configured in Supabase Storage)
NEXT_PUBLIC_STORAGE_BUCKET=transfers
